[node name="Rules" type="Label" parent="Center/VBox"]
theme_override_font_sizes/font_size = 22
text = "Menangkan 2 ronde untuk jadi juara. Tiap ronde 60 detik.
Kalau waktu habis, petarung dengan nyawa lebih banyak menang ronde itu.
Tahan S (P1) / panah bawah (P2) untuk BLOCK: serangan lawan tidak melukaimu!
Serangan 1 cepat tapi lemah, serangan 3 lambat tapi sakit."
horizontal_alignment = 1
autowrap_mode = 2
custom_minimum_size = Vector2(900, 0)

